# ==============================================================================
# AMRUTAM TELEMEDICINE BACKEND ENVIRONMENT CONFIGURATION (TEMPLATE)
# DO NOT COMMIT SECRETS OR SENSITIVE DATA TO VERSION CONTROL
# ==============================================================================

# Node Environment ('development' | 'test' | 'production')
NODE_ENV=development

# Server Port and Host
PORT=4000
HOST=0.0.0.0

# CORS Allowed Origins (Comma-separated)
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Logging Level ('fatal' | 'error' | 'warn' | 'info' | 'debug' | 'trace')
LOG_LEVEL=info

# PostgreSQL Database Connection URL (configured in Phase 2)
DATABASE_URL=postgresql://amrutam_user:amrutam_secret_pw@localhost:5432/amrutam_db?schema=public

# Redis Connection URL (configured in Phase 2)
REDIS_URL=redis://localhost:6379

# JWT Authentication Secrets (replace with 256-bit secure random strings in production)
JWT_ACCESS_SECRET=dev_jwt_access_secret_do_not_use_in_production_32charsmin!
JWT_REFRESH_SECRET=dev_jwt_refresh_secret_do_not_use_in_production_32charsmin!
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
